# ─────────────────────────────────────────────────────────────
# Noêma — variables d'environnement
# Copier en .env.local pour le développement. Ne JAMAIS commiter .env.local.
# ─────────────────────────────────────────────────────────────

# Clé API Google Gemini, utilisée UNIQUEMENT côté serveur.
# Absente  → l'app bascule en mode « clé du visiteur » (chacun apporte la sienne).
# Présente → l'app fonctionne en mode service : quota gratuit par visiteur.
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle par défaut. Laisser vide pour gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Nombre de générations gratuites par adresse IP et par fenêtre (mode service).
RATE_LIMIT_MAX=5
# Durée de la fenêtre en secondes (86400 = 24 h).
RATE_LIMIT_WINDOW=86400

# URL canonique publique du site, sans slash final.
# Utilisée pour les balises canonical, le sitemap et les images Open Graph.
NEXT_PUBLIC_SITE_URL=https://noema.vercel.app

# Adresse de contact affichée dans les mentions légales et la page contact.
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com
